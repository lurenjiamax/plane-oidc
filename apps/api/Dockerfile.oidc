# Retain the deployed 1.3.1 dependency environment while compiling our fork's
# Python application. Override PLANE_BACKEND_BASE with an immutable digest when
# the build host has registry access; offline builds use the preloaded image.
ARG PLANE_BACKEND_BASE=makeplane/plane-backend:v1.3.1
FROM ${PLANE_BACKEND_BASE}
WORKDIR /code
COPY manage.py manage.py
COPY plane plane/
COPY templates templates/
COPY package.json package.json
COPY bin bin/
RUN chmod +x bin/* && python -m compileall -q plane
